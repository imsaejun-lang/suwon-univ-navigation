          <i data-lucide="layers"></i>
          <span id="indoorSwitchFloorPreviewText">도착 층(2F) 도면 보기</span>
        </button>

        <button type="button" id="indoorOutdoorToEntranceBtn" class="btn-indoor-outdoor-link" title="선택한 IT대학 출입구까지 야외 캠퍼스 경로 안내">
          <i data-lucide="footprints"></i>
          <span>이 입구까지 야외 길찾기</span>
        </button>
      </div>
    </div>
  </section>

  <!-- =======================================================================
       실내 도면 뷰어 모달 (타 건물 PDF 도면 보기용)
       ======================================================================= -->
  <div id="indoorModal" class="modal-backdrop hidden" role="dialog" aria-modal="true" aria-labelledby="indoorModalTitle">
    <div class="modal-card indoor-floorplan-modal">
      <div class="modal-header">
        <div>
          <span class="modal-step-badge" id="modalStepBadge">수원대학교 공식 건축 평면도</span>
          <h3 id="indoorModalTitle" class="modal-title">미래혁신관 실내 도면 안내</h3>
        </div>
        <button type="button" id="closeIndoorModalBtn" class="sheet-x-btn" aria-label="모달 닫기">
          <i data-lucide="x"></i>
        </button>
      </div>

      <!-- 층별 선택 버튼 바 (B3 ~ 6F 등) -->
      <div class="floor-selector-bar" id="floorSelectorBar" role="tablist" aria-label="층 선택"></div>

      <!-- 선택된 층의 주요 실/강의실 요약 -->
      <div class="floor-summary-banner" id="floorSummaryBanner">
        <i data-lucide="info"></i>
        <span id="floorSummaryText">1F 주출입구 로비 · 대강의실 · 전산실습실</span>
      </div>

      <!-- 실제 PDF 도면 임베드 뷰어 영역 -->
      <div class="floorplan-viewer-frame" id="floorplanViewerContainer">
        <iframe id="floorplanPdfFrame" title="건물 층별 평면도 PDF 뷰어" src="about:blank"></iframe>
        <div id="floorplanFallbackBox" class="floorplan-fallback hidden">
          <div class="preview-row">
            <span class="preview-label">도착 건물</span>
            <strong id="modalBuildingName">본관 (대학본부)</strong>
          </div>
          <div class="preview-row">
            <span class="preview-label">층수 구성</span>
            <strong id="modalBuildingFloors">지하 1층 ~ 지상 5층</strong>
          </div>
          <div class="preview-row">
            <span class="preview-label">주요 시설</span>
            <strong id="modalBuildingPreview">1F 로비 무인발급기 · 교무입학처</strong>
          </div>
        </div>
      </div>

      <div class="modal-actions">
        <a id="openPdfNewTabLink" href="#" target="_blank" rel="noopener" class="btn-indoor-view">
          <i data-lucide="external-link"></i>
          <span>원본 도면 크게 보기</span>
        </a>
        <button type="button" id="confirmIndoorModalBtn" class="btn-find-route">
          <i data-lucide="navigation"></i>
          <span>이 건물로 길찾기</span>
        </button>
      </div>
    </div>
  </div>

  <!-- =======================================================================
       PWA 앱 다운로드 & 홈 화면 설치 유도 플로팅 배너
       ======================================================================= -->
  <aside id="pwaInstallBanner" class="pwa-install-banner hidden" role="banner" aria-label="앱 설치 안내">
    <div class="pwa-banner-left">
      <img src="assets/icons/icon-192.png" alt="앱 아이콘" class="pwa-banner-icon" />
      <div class="pwa-banner-text">
        <div class="pwa-title-row">
          <strong class="pwa-app-title">수원대 길찾기</strong>
          <span class="pwa-badge">앱 설치</span>
        </div>
        <p class="pwa-desc">홈 화면에 설치하여 인터넷 주소창 없이 앱처럼 쾌적하게 쓰세요!</p>
      </div>
    </div>
    <div class="pwa-banner-actions">
      <button type="button" id="pwaInstallBtn" class="btn-pwa-install">
        <i data-lucide="download"></i>
        <span>앱 다운로드</span>
      </button>
      <button type="button" id="pwaDismissBannerBtn" class="btn-pwa-dismiss" title="닫기" aria-label="배너 닫기">
        <i data-lucide="x"></i>
      </button>
    </div>
  </aside>

  <!-- =======================================================================
       아이폰(iOS Safari) 전용 홈 화면에 앱 추가 안내 모달
       ======================================================================= -->
  <div id="iosInstallModal" class="modal-backdrop hidden" role="dialog" aria-modal="true" aria-labelledby="iosInstallTitle">
    <div class="modal-card ios-install-card">
      <div class="ios-card-header">
        <div class="ios-header-info">
          <img src="assets/icons/icon-192.png" alt="앱 아이콘" class="ios-modal-app-icon" />
          <div>
            <h3 id="iosInstallTitle" class="ios-modal-title">아이폰(iOS) 홈 화면에 앱 추가</h3>
            <p class="ios-modal-sub">사파리 브라우저에서 2단계로 홈 화면에 앱을 설치하세요</p>
          </div>
        </div>
        <button type="button" id="closeIosInstallModalBtn" class="sheet-x-btn" aria-label="닫기">
          <i data-lucide="x"></i>
        </button>
      </div>

      <div class="ios-guide-box">
        <div class="ios-guide-step">
          <div class="step-num">1</div>
          <div class="step-desc">
            사파리(Safari) 화면 하단 바 중앙의 <strong>공유 버튼(<svg class="ios-share-inline-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"></path><polyline points="16 6 12 2 8 6"></polyline><line x1="12" y1="2" x2="12" y2="15"></line></svg>)</strong>을 터치하세요.
          </div>
        </div>

        <div class="ios-guide-step">
          <div class="step-num">2</div>
          <div class="step-desc">
            나타난 메뉴를 아래로 살짝 내려서 <strong>[홈 화면에 추가]</strong>를 누르세요.
          </div>
        </div>

        <div class="ios-guide-step">
          <div class="step-num">3</div>
          <div class="step-desc">
            우측 상단의 <strong>[추가]</strong>를 터치하면 홈 화면에 네이티브 앱처럼 아이콘이 생성됩니다!
          </div>
        </div>
      </div>

      <button type="button" id="confirmIosInstallBtn" class="btn-confirm-ios">
        확인했습니다
      </button>
    </div>
  </div>

  <!-- 토스트 알림 컨테이너 -->
  <div id="toastContainer" class="toast-container" aria-live="polite"></div>

