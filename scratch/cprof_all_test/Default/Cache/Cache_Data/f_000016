<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" />
  <meta name="theme-color" content="#08386b" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <meta name="apple-mobile-web-app-title" content="수원대길찾기" />
  <link rel="apple-touch-icon" href="assets/icons/icon-192.png" />
  <link rel="manifest" href="manifest.json" />
  <title>수원대학교 스마트 캠퍼스 내비게이션 | USW Smart Map</title>

  <!-- Pretendard 웹폰트 -->
  <link rel="stylesheet" as="style" crossorigin href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css" />

  <!-- Leaflet CSS -->
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />

  <!-- Lucide Icons -->
  <script src="https://unpkg.com/lucide@latest"></script>

  <!-- App Stylesheet -->
  <link rel="stylesheet" href="css/style.css" />
</head>
<body>
  <!-- 전체 화면 지도 캔버스 -->
  <div id="map" aria-label="수원대학교 캠퍼스 지도"></div>

  <!-- 상단 플로팅 검색창 & 카테고리 칩 영역 (UI 예시 01·02 완벽 반영) -->
  <header class="top-floating-container">
    <!-- 1. 둥근 알약형 검색바 (좌측 USW 엠블럼 + 중앙 '건물 · 강의실 검색' + 우측 돋보기) -->
    <div class="search-pill-bar" id="searchBarWrapper">
      <button type="button" id="uswBrandBtn" class="usw-emblem-btn" title="수원대학교 캠퍼스 중심으로 이동">
        <img src="assets/usw_logo.png" alt="USW 로고" class="usw-logo-img" />
      </button>

      <input
        type="text"
        id="searchInput"
        class="search-input"
        placeholder="건물 · 강의실 검색"
        autocomplete="off"
        aria-label="건물 및 강의실 검색"
      />

      <button type="button" id="clearSearchBtn" class="clear-search-btn hidden" title="검색어 지우기" aria-label="검색어 지우기">
        <i data-lucide="x"></i>
      </button>

      <button type="button" id="searchSubmitBtn" class="search-submit-btn" title="검색" aria-label="검색">
        <i data-lucide="search"></i>
      </button>
    </div>

    <!-- 2. 상단 3대 카테고리 알약 탭: [건물] [식당·카페] [편의시설] -->
    <div class="category-pills-row" role="tablist" aria-label="캠퍼스 시설 카테고리 필터">
      <button type="button" class="cat-pill active" data-category="building" role="tab" aria-selected="true">
        건물
      </button>
      <button type="button" class="cat-pill" data-category="food" role="tab" aria-selected="false">
        식당 · 카페
      </button>
      <button type="button" class="cat-pill" data-category="amenity" role="tab" aria-selected="false">
        편의시설
      </button>
    </div>

    <!-- 3. 검색 자동완성 드롭다운 리스트 -->
    <div id="autocompleteDropdown" class="autocomplete-dropdown hidden" role="listbox" aria-label="건물 및 강의실 자동완성 목록">
      <div class="dropdown-header">
        <span id="dropdownHeaderTitle">수원대학교 주요 건물 · 강의실</span>
        <span class="dropdown-sub">선택 시 건물 정보 및 길찾기</span>
      </div>
      <ul id="autocompleteList" class="autocomplete-list"></ul>
    </div>

    <!-- 4. 실시간 턴바이턴(Turn-by-Turn) 내비게이션 음성 자막 HUD 배너 -->
    <div id="navVoiceHud" class="nav-voice-hud hidden" aria-live="polite">
      <div class="hud-turn-icon-box" id="hudTurnIconBox">
        <i data-lucide="navigation"></i>
      </div>
      <div class="hud-text-content">
        <div class="hud-meta-row">
          <span class="hud-badge" id="hudStepBadge">실시간 음성 길안내</span>
          <span class="sound-wave" id="hudSoundWave">
            <span></span><span></span><span></span><span></span>
          </span>
        </div>
        <p class="hud-main-text" id="hudVoiceText">IT대학 입구까지 안내를 시작합니다.</p>
      </div>
      <button type="button" id="hudRepeatVoiceBtn" class="hud-replay-btn" title="음성 안내 다시 듣기">
        <i data-lucide="volume-2"></i>
      </button>
    </div>
  </header>

  <!-- 신규 버전 배포 감지 시 노출되는 최상단 업데이트 알림 배너 -->
  <aside id="pwaUpdateBanner" class="pwa-update-banner hidden" role="alert" aria-live="assertive">
    <div class="update-banner-icon-slot">
      <span>🚀</span>
    </div>
    <div class="update-banner-body">
      <strong>새로운 업데이트가 있습니다!</strong>
      <p id="pwaUpdateBannerMsg">최신 캠퍼스 보행로 및 기능이 반영된 새 버전이 준비되었습니다.</p>
    </div>
    <div class="update-banner-actions">
      <button type="button" id="applyUpdateBtn" class="btn-apply-update">
        <i data-lucide="download-cloud"></i>
        <span>업데이트 적용하기</span>
      </button>
      <button type="button" id="dismissUpdateBtn" class="btn-dismiss-update" title="다음에 하기">
        <i data-lucide="x"></i>
      </button>
    </div>
  </aside>

  <!-- 우측 상단 현재 버전 표시 배지 & 최신 버전 수동 업데이트 확인 버튼 -->
  <aside class="top-right-version-bar" id="appVersionBar" aria-label="앱 버전 및 업데이트 컨트롤">
    <div class="version-badge-pill" id="versionBadgePill" title="수원대 길찾기 현재 설치 버전">
      <span class="version-dot"></span>
      <span class="version-text" id="appVersionTag">v1.0.0</span>
    </div>
    <button type="button" id="manualUpdateBtn" class="manual-update-btn" title="새 버전 확인 및 캐시 강제 초기화 후 최신 코드로 새로고침">
      <i data-lucide="refresh-cw"></i>
      <span>최신 버전 확인</span>
    </button>
  </aside>

  <!-- 좌측 상단 나침반 버튼 (UI 예시의 N ▲ 알약 버튼) -->
  <div class="left-floating-controls">
    <button type="button" id="resetCampusViewBtn" class="compass-pill-btn" title="정북 방향 및 캠퍼스 중심 복귀" aria-label="나침반 및 캠퍼스 중심 복귀">
      <span class="compass-n">N</span>
      <span class="compass-arrow">&#9650;</span>
    </button>

    <!-- 보행로 그래프 디버그 토글 미니 버튼 -->
    <button type="button" id="toggleGraphDebugBtn" class="mini-graph-btn active" title="캠퍼스 보행로 네트워크(노드/간선) 표시 켜기/끄기">
      <i data-lucide="git-branch"></i>
      <span>보행로</span>
    </button>
  </div>

  <!-- 우측 플로팅 컨트롤 영역 (UI 예시의 [로드뷰] 카드 + [내 위치] 타겟 버튼 + TTS/시뮬레이션) -->
  <aside class="right-floating-controls" id="rightFloatingControls" aria-label="지도 및 내비게이션 컨트롤">
    <!-- 1. 로드뷰 / 위성뷰 전환 카드 버튼 (UI 예시 우측 상단 카메라 카드) -->
    <button type="button" id="mapLayerToggleBtn" class="roadview-card-btn" title="위성뷰 / 캠퍼스 로드뷰 전환">
      <i data-lucide="camera" class="rv-icon"></i>
      <span id="mapLayerLabel">로드뷰</span>
    </button>

    <!-- 2. 내 위치(GPS) 원형 타겟 버튼 (UI 예시의 조준선 아이콘) -->
    <button type="button" id="myLocationBtn" class="gps-circle-btn active" title="내 위치(실시간 GPS)로 이동" aria-label="내 위치로 이동">
      <i data-lucide="locate-fixed"></i>
    </button>

    <!-- 3. 음성 안내(TTS) 켜기/끄기 스피커 원형 버튼 -->
    <button type="button" id="ttsToggleBtn" class="gps-circle-btn tts-btn active" title="음성 안내 켜기/끄기 (한국어 TTS)" aria-label="음성 안내 켜기/끄기">
      <span id="ttsToggleIconWrap" class="icon-slot"><i data-lucide="volume-2"></i></span>
      <span class="tts-mini-badge" id="ttsStatusBadge">ON</span>
    </button>

      <!-- 4. [가상 이동 시뮬레이션] 플로팅 테스트 버튼 -->
      <button type="button" id="floatingSimBtn" class="sim-floating-pill" title="내 위치 마커가 경로를 따라 자동 이동하며 TTS 음성을 테스트합니다">
        <span class="sim-pulse-dot"></span>
        <span id="floatingSimIconWrap" class="icon-slot"><i data-lucide="play-circle"></i></span>
        <span id="floatingSimLabel">시뮬레이션</span>
      </button>

      <!-- 5. [길 교정 모드] 마우스 클릭 도로/경로 직접 편집 관리자 툴 -->
      <button type="button" id="floatingRoadEditorBtn" class="sim-floating-pill road-editor-pill" title="지도 위 큰길을 직접 클릭하여 도로 굴곡을 다듬고 JSON으로 복사합니다">
        <span class="editor-tool-dot"></span>
        <span id="floatingRoadEditorIconWrap" class="icon-slot"><i data-lucide="wrench"></i></span>
        <span id="floatingRoadEditorLabel">길 교정 모드</span>
      </button>
    </aside>

    <!-- [길 교정 모드 (Road Calibration Tool)] 플로팅 관리자 툴바 -->
    <div id="roadEditorToolbar" class="road-editor-toolbar hidden" role="toolbar" aria-label="경로 및 도로 직접 교정 툴바">
      <div class="ret-top-row">
        <div class="ret-title-box">
          <span class="ret-badge">🛠️ 길 교정 모드 (관리자 툴)</span>
          <span id="retPointCount" class="ret-count-pill">0개 포인트</span>
        </div>
        <button type="button" id="retCloseBtn" class="ret-icon-close-btn" title="길 교정 모드 닫기">
          <i data-lucide="x"></i>
        </button>
      </div>
      <p class="ret-tip-msg">
        💡 <strong>지도 위 실제 큰길을 마우스로 콕콕 클릭</strong>하면 도로 커브 점이 실시간 추가됩니다.<br>
        생성된 점을 마우스로 드래그하여 정확한 도로 선 위로 이동할 수 있습니다.
      </p>
      <div class="ret-actions-row">
        <button type="button" id="retUndoBtn" class="ret-action-btn" title="마지막으로 추가한 점 하나 삭제">
          <i data-lucide="undo-2"></i>
          <span>취소 (Undo)</span>
        </button>
        <button type="button" id="retClearBtn" class="ret-action-btn ret-danger" title="모든 교정 점 삭제">
          <i data-lucide="trash-2"></i>
          <span>전체 초기화</span>
        </button>
        <button type="button" id="retApplyBtn" class="ret-action-btn ret-primary" title="편집된 도로선을 현재 길안내 경로에 즉시 덮어씌웁니다">
          <i data-lucide="check-circle-2"></i>
          <span>현재 경로에 반영</span>
        </button>
        <button type="button" id="retCopyJsonBtn" class="ret-action-btn ret-copy" title="교정된 도로 좌표(lat, lng)를 클립보드에 복사합니다">
          <i data-lucide="copy"></i>
          <span>JSON 복사</span>
        </button>
      </div>
    </div>

  <!-- =======================================================================
       하단 바텀 시트 (드래그 이동 / 리사이즈 / 3단계 크기 전환 / 글래스모피즘 지원)
       ======================================================================= -->
  <section id="bottomSheet" class="bottom-sheet" aria-label="캠퍼스 건물 및 길찾기 시트">
    <!-- 크기 조절 리사이즈 핸들 -->
    <div class="sheet-resize-handle top" data-handle="top" title="위아래 크기 조절"></div>
    <div class="sheet-resize-handle top-left" data-handle="top-left" title="모서리 크기 조절"></div>
    <div class="sheet-resize-handle top-right" data-handle="top-right" title="모서리 크기 조절"></div>
    <div class="sheet-resize-handle left" data-handle="left" title="좌우 크기 조절"></div>
    <div class="sheet-resize-handle right" data-handle="right" title="좌우 크기 조절"></div>

    <!-- 최소화(한 줄 모드) 시 활성화되는 슬림 정보 바 -->
    <div id="sheetMiniBar" class="sheet-mini-bar hidden" title="클릭 시 창을 다시 펼칩니다">
      <div class="mini-bar-left">
        <span class="mini-pulse-dot"></span>
        <strong id="miniBarTitle" class="mini-bar-title">IT대학</strong>
        <span id="miniBarMetrics" class="mini-bar-metrics">약 6분 · 420m</span>
      </div>
      <div class="mini-bar-actions">
        <button type="button" id="miniStartNavBtn" class="mini-action-btn primary" title="안내 시작">
          <i data-lucide="navigation"></i>
          <span id="miniStartNavBtnText">안내</span>
        </button>
        <button type="button" id="miniOpenIndoorBtn" class="mini-action-btn indoor" title="실내 도면 보기">
          <i data-lucide="building-2"></i>
          <span>실내</span>
        </button>
        <button type="button" id="miniExpandBtn" class="mini-action-btn expand" title="창 크게 펼치기">
          <i data-lucide="chevron-up"></i>
          <span>펼치기</span>
        </button>
      </div>
    </div>

    <div class="sheet-drag-handle-area" id="sheetHandleArea" title="드래그하여 창 위치 자유 이동 (클릭 시 접기/펼치기)">
      <div class="sheet-drag-bar"></div>
    </div>

    <!-- [State 01] 앱을 켰을 때: "어디로 가볼까요?" 홈 탐색 뷰 (UI 예시 01) -->
    <div id="sheetViewExplore" class="sheet-view">
      <div class="explore-header">
        <h2 class="explore-title" id="exploreTitle">어디로 가볼까요?</h2>
        <p class="explore-subtitle" id="exploreSubtitle">건물부터 강의실까지 한 번에 찾아요</p>
      </div>

      <!-- 사진으로 미리보기 카드 리스트 (UI 예시 01의 카드 디자인) -->
      <div id="explorePreviewList" class="explore-preview-list">
        <!-- JS에서 미래혁신관, IT대학, 중앙도서관 등 미리보기 카드 렌더링 -->
      </div>

      <!-- 빠른 건물 선택 칩 스크롤 -->
      <div class="quick-chips-scroll" id="quickBuildingChips" role="list" aria-label="주요 건물 빠른 선택"></div>
    </div>

    <!-- [State 02] 건물을 선택했을 때: 건물 상세 프리뷰 & [실내 보기] / [길찾기] (UI 예시 02) -->
    <div id="sheetViewBuilding" class="sheet-view hidden">
      <div class="building-sheet-header">
        <div class="building-title-wrap">
          <div class="building-title-line">
            <h2 class="building-main-title" id="detailBuildingName">미래혁신관</h2>
            <button type="button" id="bookmarkBuildingBtn" class="bookmark-icon-btn" title="저장하기">
              <i data-lucide="bookmark"></i>
            </button>
          </div>
          <p class="building-sub-caption" id="detailBuildingSub">수원대학교 · 건물 안내</p>
        </div>
        <button type="button" id="closeDetailSheetBtn" class="sheet-x-btn" title="닫기" aria-label="건물 상세 닫기">
          <i data-lucide="x"></i>
        </button>
      </div>

      <!-- 건물 공식 사진 와이드 배너 -->
      <div class="building-photo-banner" id="detailPhotoBanner">
        <img src="assets/future_innovation.png" alt="건물 공식 사진" id="detailBuildingImg" class="building-banner-img" />
        <span class="official-photo-badge">학교 공식 사진</span>
        <span class="floor-count-badge" id="detailFloorBadge">지하 3층 ~ 지상 8층</span>
      </div>

      <p class="building-guide-copy" id="detailBuildingCopy">건물을 확인하고, 실내로 이어가세요</p>

      <!-- UI 예시 02의 핵심 듀얼 버튼: [실내 보기] & [길찾기] -->
      <div class="building-dual-actions">
        <button type="button" id="openFloorPlanBtn" class="btn-indoor-view">
          <i data-lucide="camera"></i>
          <span>실내 보기</span>
        </button>
        <button type="button" id="goRouteViewBtn" class="btn-find-route">
          <svg class="route-s-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="6" cy="19" r="2.5"></circle>
            <path d="M8.5 19H15a3.5 3.5 0 0 0 0-7H9a3.5 3.5 0 0 1 0-7h6.5"></path>
            <circle cx="18" cy="5" r="2.5"></circle>
          </svg>
          <span>길찾기</span>
        </button>
      </div>
    </div>

    <!-- [State 03] 길찾기 및 실시간/시뮬레이션 내비게이션 뷰 (구글/네이버 지도 길찾기 스타일) -->
    <div id="sheetViewRoute" class="sheet-view hidden">
      <!-- 상단 출발지 -> 목적지 바 -->
      <div class="route-header-row">
        <div class="route-title-group">
          <div class="route-badges-line">
            <span class="route-tag" id="sheetRouteTag">도보 최단경로</span>
            <span class="category-tag" id="sheetCategoryTag">단과대학</span>
          </div>
          <h2 class="dest-building-name" id="sheetBuildingName">IT대학</h2>
          <div class="route-origin-dest-bar">
            <span class="origin-pill">출발</span>
            <select id="startNodeSelect" aria-label="출발지 선택">
              <option value="main_gate">정문 (주출입구)</option>
              <option value="back_gate">후문 (제4공학관·고시길)</option>
              <option value="west_gate_cu">경상관 CU 쪽문 (서측 외부)</option>
              <option value="future_innovation">미래혁신관</option>
              <option value="it_college">IT대학</option>
              <option value="central_library">중앙도서관</option>
              <option value="main_building">본관</option>
              <option value="lecture_hall">종합강의동</option>
              <option value="student_union">학생회관</option>
            </select>
            <i data-lucide="arrow-right" class="inline-arrow"></i>
            <span class="dest-pill-text" id="sheetEndName">IT대학 입구</span>
          </div>

          <!-- 주요 출발 지점 빠른 선택 테스트 칩 (정문 / 후문 / 경상관 CU 쪽문) -->
          <div class="test-origin-chips-bar" id="testOriginChipsBar">
            <span class="test-origin-bar-label">🚩 출발지 프리셋:</span>
